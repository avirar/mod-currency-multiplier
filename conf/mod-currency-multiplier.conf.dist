[worldserver]

#####################################################
# Currency Multiplier module configuration
#####################################################
#
#    CurrencyMultiplier.Rate
#        Description: Multiplier for currency-token items gained from loot,
#                     quest rewards and spell-created items.
#                     Does not affect vendor exchanges, refunds, trades, mail,
#                     bank, auction or buyback.
#        Range:       >= 1; values below 1 are rejected and fall back to 1.
#        Default:     1
#
CurrencyMultiplier.Rate = 1
